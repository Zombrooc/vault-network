{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Least-privilege capability for the main Vault Network window",
  "windows": ["main"],
  "permissions": [
    "core:window:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-activate-container",
    "allow-change-password",
    "allow-compact-container",
    "allow-copy-object",
    "allow-create-contact-card",
    "allow-create-container",
    "allow-create-folder",
    "allow-create-invitation",
    "allow-decode-contact-card",
    "allow-delete-folder",
    "allow-delete-object",
    "allow-download-invitation",
    "allow-export-file",
    "allow-export-header-backup",
    "allow-import-file",
    "allow-list-folders",
    "allow-list-objects",
    "allow-lock-container",
    "allow-open-invitation",
    "allow-preview-image",
    "allow-publish-discovery",
    "allow-query-discovery",
    "allow-rename-folder",
    "allow-rename-object",
    "allow-restore-header-backup",
    "allow-revoke-swarm",
    "allow-rotate-cmk",
    "allow-rotate-recovery-key",
    "allow-seed-invitation",
    "allow-seed-object",
    "allow-unlock-container",
    "allow-unlock-container-recovery"
  ]
}
